# systemd unit for Law Minded. Installed by deploy/setup.sh, which replaces the
# __APP_DIR__ / __APP_USER__ placeholders with real values. Keeps the app
# always-on and restarts it on crash or server reboot.
[Unit]
Description=Law Minded (gunicorn)
After=network.target

[Service]
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__APP_DIR__
Environment=PATH=__APP_DIR__/venv/bin
ExecStart=__APP_DIR__/venv/bin/gunicorn -c gunicorn.conf.py app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
