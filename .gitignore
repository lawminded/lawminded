# Secrets — never commit
.env

# Python
__pycache__/
*.py[cod]
venv/
.venv/
env/

# Local database (created at runtime)
instance/
*.db
*.sqlite3

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Local Claude state (worktrees, settings) stays out. The project's own skills
# do not: they have to reach the writer box, and copying skills by hand is
# exactly how the first automated run silently wrote an article without the
# humanizer. Anything under .claude/skills/lawminded-* is part of the repo.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/lawminded-*/

# Local SEO audit artefacts (large, not part of the site)
SEO Audit/
automation/logs/

# Bot retry queue — transient state, not history.
automation/.bot_retry.json
automation/.bot_session
